{
  "manifest_version": 3,
  "name": "PersonalOS",
  "description": "Your PersonalOS assistant beside every page: same account, same memory, same tasks, same files.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png" },
  "action": { "default_title": "Open PersonalOS", "default_icon": { "16": "icons/icon.png", "32": "icons/icon.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "assets/background.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "activeTab", "scripting", "contextMenus"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
