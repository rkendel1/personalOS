{
  "name": "personalos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "feltkit dev",
    "build": "feltkit build",
    "start": "feltkit start",
    "test": "feltkit test",
    "inspect": "feltkit inspect",
    "deploy": "feltkit deploy",
    "typecheck": "tsc --noEmit",
    "e2e:ui": "node e2e/ui.mjs",
    "e2e:model": "node e2e/model.mjs",
    "extension:build": "vite build -c vite.extension.config.ts",
    "e2e:extension": "npm run extension:build && node e2e/extension.mjs"
  },
  "dependencies": {
    "@feltdb/feltkit": "0.3.24",
    "@stack-ui/core": "file:vendor/stack-ui/core",
    "@stack-ui/react": "file:vendor/stack-ui/react",
    "@stack-ui/tokens": "file:vendor/stack-ui/tokens",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "@types/chrome": "0.0.304"
  },
  "description": "A personal assistant on FeltKit: durable conversations, memory, tasks, reminders, daily briefing and an auditable action log."
}
