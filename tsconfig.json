{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": [
      "node",
      "vite/client",
      "chrome"
    ]
  },
  "include": [
    "src",
    "feltkit",
    "tests",
    "extension/src",
    "vite.config.ts",
    "vite.extension.config.ts"
  ]
}
