+    x.expiresIn = 7200;
+    await connectBot(t);
+    await poll(t);
+    assert.ok((await invocationsOf(t, "ada")).some((i: any) => i.invocationId === `x-${c}`), "read once reconnected: the cursor did not move past it");
+  });
